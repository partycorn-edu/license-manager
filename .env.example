# Скопируйте в .env и замените значения. Файл .env в Git не попадает.

# Порт, на котором gateway доступен снаружи (на сервере, где порт 80 занят, возьмите другой, например 8088)
GATEWAY_PORT=8080

# Образы. Локально можно оставить как есть. Для GHCR: ghcr.io/ВАШ_GITHUB_ЛОГИН (строчными буквами)
REGISTRY=local
TAG=local

# База данных
POSTGRES_DB=licenses
POSTGRES_USER=licenses
POSTGRES_PASSWORD=change_me_db_password

# Авторизация
JWT_SECRET=change_me_to_a_long_random_string_32chars_min
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
VIEWER_PASSWORD=change_me_viewer_password

# Воркер
WORKER_INTERVAL_SECONDS=60
EXPIRY_WARN_DAYS=30

# Redis (кэш дашборда). Чтобы отключить, поставьте false
REDIS_ENABLED=true

# Grafana
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
